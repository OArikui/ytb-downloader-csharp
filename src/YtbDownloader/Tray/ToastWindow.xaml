<Window x:Class="YtbDownloader.Tray.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTB Downloader"
        Width="440"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#F0F0F0"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">
    <Border BorderBrush="#999" BorderThickness="1" Padding="10">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    </Border>
</Window>
